# Public Firebase web values (these are configuration, not secret credentials).
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=

# Server-only JSON service account key. Never commit a real value or place it in VITE_*.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Map Firebase Authentication UIDs to the fixed roles below. Do not map by email.
CALL_ADMIN_UIDS_JSON={"FIREBASE_UID_1":{"role":"general_manager"},"FIREBASE_UID_2":{"role":"business_development_manager"},"FIREBASE_UID_3":{"role":"deputy_general_manager"}}

# Required 32+ character random secret used only to HMAC client IPs for persistent login rate limiting.
# Generate locally with a cryptographically secure random generator; never commit the generated value.
CALL_AUTH_RATE_LIMIT_SECRET=

# Separate random secret used to sign 12-hour HttpOnly admin session cookies.
CALL_AUTH_SESSION_SECRET=

# Server-only GroqCloud text-to-speech. Never use a VITE_ prefix.
GROQ_API_KEY=
GROQ_VOICE=fahad
GROQ_SPEECH_CONFIG_VERSION=aait-ar-sa-v1

# Allowlisted Firebase Anonymous UIDs of trusted display computers (maximum 5).
# Unknown anonymous identities cannot trigger Groq generation or consume an event's attempt.
CALL_DISPLAY_UIDS_JSON=[]

# WAV files use bundled public/audio/calls assets and the display computer's IndexedDB.
# No Firebase Storage, Supabase, Blob token, billing plan or bucket is required.

# Optional override for the published Google Sheet key.
GOOGLE_SHEETS_PUBLISH_KEY=
