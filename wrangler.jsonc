{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aait-sales",
  "account_id": "4df227652891f2f59399ce1b462fb720",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "secrets": {
    "required": [
      "FIREBASE_WEB_API_KEY",
      "FIREBASE_PROJECT_ID",
      "FIREBASE_DATABASE_URL",
      "FIREBASE_SERVICE_ACCOUNT_JSON",
      "CALL_ADMIN_UIDS_JSON",
      "CALL_AUTH_RATE_LIMIT_SECRET",
      "CALL_AUTH_SESSION_SECRET",
      "GROQ_API_KEY"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/control",
      "/control/",
      "/favicon.ico"
    ]
  }
}
